{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lolo.io.vn"
        }
      ],
      "destination": "https://www.lolo.com.vn/",
      "permanent": false
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "lolo.io.vn"
        }
      ],
      "destination": "https://www.lolo.com.vn/:path+",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.lolo.io.vn"
        }
      ],
      "destination": "https://www.lolo.com.vn/",
      "permanent": false
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.lolo.io.vn"
        }
      ],
      "destination": "https://www.lolo.com.vn/:path+",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=()"
        }
      ]
    },
    {
      "source": "/quantri(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
