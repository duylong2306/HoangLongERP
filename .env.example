# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Connection settings for Supabase database.
# Get these from: Supabase Dashboard > Project Settings > API
#
# ⚠️ VERCEL DEPLOYMENT: You MUST set these in Vercel Dashboard > Settings > Environment Variables
# Without these, the app will show EMPTY data because it cannot connect to Supabase.
VITE_SUPABASE_URL="https://cyuunmrdrymhzxfcruoe.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# WEB PUSH VAPID Keys (Push Notifications)
# Tạo bằng: npx web-push generate-vapid-keys
# PUBLIC key dùng cho frontend (VITE_ prefix)
# PRIVATE key chỉ lưu ở Supabase Edge Function, KHÔNG commit lên git
VITE_WEBPUSH_VAPID_PUBLIC_KEY="your-vapid-public-key-here"

# SUBDOMAIN THEO DOANH NGHIỆP (multi-tenant — nhánh multi-tenant)
# Tên miền gốc; mỗi doanh nghiệp đăng nhập tại <ma-cong-ty>.<tên-miền-gốc> (ví dụ hoanglong.lolo.vn).
# Có thể nhiều giá trị, cách nhau dấu phẩy (production + staging dùng 2 tên miền gốc khác nhau):
#   VITE_BASE_DOMAIN="lolo.vn,stg.lolo.vn"
# Dev trên máy: VITE_BASE_DOMAIN="localhost" rồi mở http://hoanglong.localhost:5173
# KHÔNG đặt biến này (để trống) → mọi địa chỉ dùng cách cũ: nhập "Mã công ty" ở form đăng nhập.
# ⚠️ Phải đặt trên Vercel (cả frontend lẫn api/ đọc cùng biến này) và deploy lại sau khi đổi.
VITE_BASE_DOMAIN=""

# ĐĂNG KÝ DOANH NGHIỆP CÔNG KHAI (Giai đoạn 2) — CAPTCHA Cloudflare Turnstile (miễn phí)
# Tạo site ở Cloudflare Dashboard > Turnstile, lấy Site key (công khai) và Secret key (bí mật).
# Không đặt 2 biến này → form vẫn chạy nhưng KHÔNG có CAPTCHA (chỉ có giới hạn số lần theo IP): chỉ nên để vậy ở staging.
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
