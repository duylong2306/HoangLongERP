# ── MÔI TRƯỜNG NHÂN BẢN (Giai đoạn 0 — Multi-tenant) ─────────────────────────
# File này liệt kê các biến môi trường cần cho project Vercel STAGING mới
# (nhánh git `multi-tenant`), trỏ vào project Supabase STAGING mới (KHÔNG phải
# project production đang chạy thật). KHÔNG điền secret thật vào file này —
# chỉ dùng để tra cứu tên biến, giá trị thật nhập trực tiếp ở Vercel Dashboard
# > Settings > Environment Variables (project STAGING), không commit lên git.

# ── Giống .env.example hiện tại nhưng trỏ vào Supabase project STAGING mới ──
VITE_SUPABASE_URL="https://<staging-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key-cua-project-staging>"

# ── MỚI cho multi-tenant: dùng ở Vercel Serverless Function /api/login.ts ──
# Lấy ở Supabase Dashboard (project STAGING) > Project Settings > API.
# ⚠️ KHÔNG có tiền tố VITE_ — các biến này KHÔNG được đưa lên trình duyệt,
# chỉ server (Vercel Serverless Function) đọc được.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-cua-project-staging>"
SUPABASE_JWT_SECRET="<jwt-secret-cua-project-staging>"

# WEB PUSH VAPID Keys — tạo riêng cho project staging (không dùng chung key
# với production, tránh gửi nhầm thông báo giữa 2 môi trường).
VITE_WEBPUSH_VAPID_PUBLIC_KEY="<vapid-public-key-staging>"
